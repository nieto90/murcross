{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murcross.local/schema/level.schema.json",
  "title": "Murcross Level v1",
  "type": "object",
  "required": ["schemaVersion", "id", "play", "reveal"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "play": {
      "type": "object",
      "required": ["size", "rooms", "victim", "pawns", "objects", "edge"],
      "additionalProperties": false,
      "properties": {
        "size": { "type": "integer", "minimum": 5, "maximum": 7 },
        "rooms": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          }
        },
        "roomMeta": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "short"],
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "short": { "type": "string" },
              "token": { "type": "string" }
            }
          }
        },
        "victim": {
          "type": "object",
          "required": ["r", "c"],
          "properties": {
            "r": { "type": "integer", "minimum": 0 },
            "c": { "type": "integer", "minimum": 0 }
          }
        },
        "pawns": {
          "type": "object",
          "required": ["count"],
          "additionalProperties": false,
          "properties": {
            "count": { "type": "integer", "minimum": 1, "maximum": 4 }
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "shapeId", "cells"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "shapeId": { "type": "string" },
              "cells": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["dr", "dc"],
                  "properties": {
                    "dr": { "type": "integer" },
                    "dc": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "edge": {
          "type": "object",
          "required": ["rows", "cols"],
          "properties": {
            "rows": { "$ref": "#/$defs/edgeLines" },
            "cols": { "$ref": "#/$defs/edgeLines" }
          }
        }
      }
    },
    "reveal": {
      "type": "object",
      "required": ["suspects", "objects"],
      "additionalProperties": false,
      "properties": {
        "suspects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pawnIndex", "name", "cell"],
            "properties": {
              "pawnIndex": { "type": "integer", "minimum": 0 },
              "name": { "type": "string" },
              "cell": {
                "type": "object",
                "required": ["r", "c"],
                "properties": {
                  "r": { "type": "integer" },
                  "c": { "type": "integer" }
                }
              },
              "must_room": { "type": "integer" }
            }
          }
        },
        "objects": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "culpritPawnIndex": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "edgeLines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segments", "people", "objects"],
        "properties": {
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["roomId", "count"],
              "properties": {
                "roomId": { "type": "integer" },
                "count": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "people": { "type": "integer", "minimum": 0 },
          "objects": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
